{
  "name": "paperlint",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Deterministic-first review pipeline for research manuscripts: terminology near-misses, citation resolution, retraction detection, reference-list integrity, figure/table cross-references, summary consistency — plus an optional LLM adjudication layer against any OpenAI-compatible provider (bring your own key).",
  "repository": {
    "type": "git",
    "url": "https://github.com/AifaDev/paperlint"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "web": "npm run build && node web/server.mjs",
    "check:clean": "node scripts/check-clean.mjs",
    "bench:fetch": "node scripts/fetch-benchmarks.mjs",
    "bench:deterministic": "npm run build && node scripts/bench-deterministic.mjs",
    "bench:d1": "npm run build && node scripts/bench-claim-source.mjs",
    "bench:retraction": "npm run build && node scripts/bench-retraction.mjs"
  },
  "dependencies": {
    "node-html-parser": "^7.0.1"
  },
  "devDependencies": {
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/header": "^2.8.9",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/marker": "^1.4.0",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/simple-image": "^1.6.0",
    "@editorjs/table": "^2.4.6",
    "@editorjs/underline": "^1.2.1",
    "@types/node": "^22.0.0",
    "mammoth": "^1.12.1",
    "typescript": "^5.9.0",
    "unpdf": "^1.8.1"
  }
}
